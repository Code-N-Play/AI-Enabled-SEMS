  <title>Smart Sockets</title>

  <link rel="stylesheet" href="../stylesheets/bootstrap.min.css"> 
  <link rel="stylesheet" href="../vendors/bootstrap-icons/bootstrap-icons.css"> 
  <link rel="stylesheet" href="../stylesheets/style.css">
  <style>
    .socket-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .socket-card {
        background: white;
        border: 1px solid #e1e7e4;
        border-radius: 15px;
        padding: 20px;
        transition: 0.2s;
    }

    .socket-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 18px rgba(0,0,0,0.06);
    }

    .socket-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .socket-name {
        font-size: 17px;
        font-weight: 600;
    }

    .status {
        font-size: 12px;
        padding: 5px 9px;
        border-radius: 20px;
    }

    .online {
        background: #e4f7ed;
        color: #168653;
    }

    .offline {
        background: #f2f2f2;
        color: #777;
    }

    .socket-info {
        margin-top: 18px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .info-box {
        background: #f7f9f8;
        padding: 12px;
        border-radius: 9px;
    }

    .info-box small {
        color: #7b8581;
        font-size: 11px;
    }

    .info-box strong {
        display: block;
        margin-top: 5px;
        font-size: 16px;
    }

    .control {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .control-text {
        font-size: 13px;
        color: #707a76;
    }

    .switch {
        position: relative;
        width: 50px;
        height: 27px;
    }

    .switch input {
        display: none;
    }

    .slider {
        position: absolute;
        inset: 0;
        background: #cdd4d1;
        border-radius: 30px;
        cursor: pointer;
        transition: 0.3s;
    }

    .slider:before {
        content: "";
        position: absolute;
        height: 21px;
        width: 21px;
        left: 3px;
        top: 3px;
        background: white;
        border-radius: 50%;
        transition: 0.3s;
    }

    input:checked + .slider {
        background: #168653;
    }

    input:checked + .slider:before {
        transform: translateX(23px);
    }
    /* ---------- SUMMARY CARDS ---------- */

    .summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 30px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e3e8e5;
        border-radius: 13px;
        padding: 20px;
    }
    .summary-card:hover{
        background: rgb(230, 252, 236);
        border: 1px solid #008332;
        border-radius: 13px;
        padding: 20px;
    }

    .summary-card span {
        color: #737d79;
        font-size: 13px;
    }

    .summary-card h2 {
        margin-top: 9px;
        font-size: 25px;
    }

    .green {
        color: #168653;
    }

    .orange {
        color: #d98519;
    }
  </style>
  
</head>

