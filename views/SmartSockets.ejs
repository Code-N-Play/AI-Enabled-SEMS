<% layout("layouts/boilerplate") %>

    <div class="container-fluid sockets-list px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-plug" aria-hidden="true"></i></span>
                <div>
                    <h1 class="h3 mb-1">Smart Sockets</h1>
                    <p class="eyebrow mb-1">Monitor and remotely control connected classroom appliances.</p>

                </div>
            </div>

        </div>

        <div class="summary">

            <div class="summary-card">

                <span>Total Sockets</span>

                <h2>12</h2>

            </div>


            <div class="summary-card">

                <span>Currently ON</span>

                <h2 class="green">7</h2>

            </div>


            <div class="summary-card">

                <span>Currently OFF</span>

                <h2>5</h2>

            </div>


            <div class="summary-card">

                <span>Online Devices</span>

                <h2 class="green">11/12</h2>

            </div>

        </div>

        <section class="row g-3 mt-1">
            <div class="socket-grid">


                <!-- SOCKET 1 -->

                <% for(const socket of sockets){ %>

                <div class="socket-card">

                    <div class="socket-header">

                        <div class="socket-name">
                            <%= socket.name %>
                        </div>

                        <span class="status <%= socket.isActive ? 'online' : 'offline'%>">
                            <%= socket.isActive ? "● Online" : "● Offline"%>
                            
                        </span>

                    </div>


                    <div class="socket-info">

                        <div class="info-box">

                            <small>Device</small>

                            <strong>Fan</strong>

                        </div>

                        <div class="info-box">

                            <small>Power</small>

                            <strong>72 W</strong>

                        </div>

                        <div class="info-box">

                            <small>Voltage</small>

                            <strong>230 V</strong>

                        </div>

                        <div class="info-box">

                            <small>Mode</small>

                            <strong>Auto</strong>

                        </div>

                    </div>


                    <div class="control">

                        <span class="control-text">
                            Power Control
                        </span>

                        <label class="switch">

                            <input type="checkbox" <%= socket.isActive ? 'checked' : ''%>  class="statusChangeSwitch"  data-id="<%= socket.id %>">

                            <span class="slider"></span>

                        </label>

                    </div>

                </div>


                <% } %>




            </div>



        </section>


    </div>

    <script src="/javascripts/smartscript.js"></script>

